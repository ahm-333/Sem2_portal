{
  "name": "sem2-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Static semester portal with local development and quality checks",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node tools/serve.cjs",
    "build": "node tools/build-assets.cjs",
    "package": "node tools/package-site.cjs",
    "check": "node tools/check-syntax.cjs",
    "validate": "node tools/check-data.cjs",
    "lint": "eslint js tests tools/*.cjs *.cjs --max-warnings=0",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:a1": "node tests/a1-browser.cjs",
    "test:study": "node tests/study-features-browser.cjs",
    "test:os": "node education-preview/os/check.cjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=js/shared/*.js tests/*.test.cjs",
    "test:production": "npm run package && node tests/production-browser.cjs",
    "verify": "npm run build && npm run check && npm run validate && npm run lint && npm test && npm run test:browser && npm run test:a1 && npm run test:study && npm run test:os && npm run test:production"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "espree": "11.2.0",
    "lucide": "1.59.0",
    "mermaid": "10.9.8",
    "playwright": "1.62.1",
    "tailwindcss": "3.4.17",
    "three": "0.186.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
