        "after": "        <!-- Card: Lecture 4 -->\n        <article class=\"glass-card rounded-3xl p-6 flex flex-col justify-between space-y-5 border relative overflow-hidden group\">\n          <div class=\"space-y-4\">\n            <div class=\"flex items-center justify-between\">\n              <span class=\"w-12 h-12 rounded-2xl bg-amber-600 text-white font-mono font-black text-lg flex items-center justify-center shadow-lg shadow-amber-500/20\">\n                L4\n              </span>\n              <span class=\"text-[11px] px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 font-bold\">\n                محاكي تفاعلي وكويز\n              </span>\n            </div>\n\n            <div>\n              <span class=\"text-xs font-mono text-slate-400 block mb-1\">Lecture 4</span>\n              <h4 class=\"text-base sm:text-lg font-black text-white group-hover:text-amber-300 transition-colors\">\n                المحاضرة الرابعة: هيكل المكدس (Stacks)\n              </h4>\n              <p class=\"text-xs text-slate-400 mt-1 font-mono\">Stack ADT, DynamicStack & Applications</p>\n            </div>\n\n            <p class=\"text-xs text-slate-300 leading-relaxed\">\n              مبدأ LIFO، عمليات push و pop و peek، تطبيق المصفوفات والقوائم المتصلة، معالجة Overflow و Underflow، ومحاكي الـ Stack التفاعلي.\n            </p>\n\n            <div class=\"space-y-1.5 pt-2 border-t border-white/10 text-[11px] text-slate-400\">\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-emerald-400\">✓</span>\n                <span>محاكي Array Stack تفاعلي خطوة بخطوة</span>\n              </div>\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-emerald-400\">✓</span>\n                <span>تطبيق عملي كامل بلغة C++ مع الـ Templates</span>\n              </div>\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-emerald-400\">✓</span>\n                <span>كويز فوري بـ 10 أسئلة تفاعلية</span>\n              </div>\n            </div>\n          </div>\n\n          <a href=\"lecture-4.html\" class=\"btn-gradient w-full py-3 px-4 rounded-2xl text-white font-black text-xs text-center flex items-center justify-center gap-2 shadow-lg\">\n            <span>فتح الشرح التفاعلي (L4)</span>\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M10 19l-7-7m0 0l7-7m-7 7h18\"/></svg>\n          </a>\n        </article>\n\n        <!-- Card: Lecture 7 -->\n        <article class=\"glass-card rounded-3xl p-6 flex flex-col justify-between space-y-5 border relative overflow-hidden group\">\n          <div class=\"space-y-4\">\n            <div class=\"flex items-center justify-between\">\n              <span class=\"w-12 h-12 rounded-2xl bg-teal-600 text-white font-mono font-black text-lg flex items-center justify-center shadow-lg shadow-teal-500/20\">\n                L7\n              </span>\n              <span class=\"text-[11px] px-2.5 py-1 rounded-full bg-teal-500/10 text-teal-400 border border-teal-500/20 font-bold\">\n                رسومات تفاعلية وكويز\n              </span>\n            </div>\n\n            <div>\n              <span class=\"text-xs font-mono text-slate-400 block mb-1\">Lecture 7</span>\n              <h4 class=\"text-base sm:text-lg font-black text-white group-hover:text-amber-300 transition-colors\">\n                المحاضرة السابعة: الأشجار (Trees)\n              </h4>\n              <p class=\"text-xs text-slate-400 mt-1 font-mono\">Trees, Binary Trees & Traversals</p>\n            </div>\n\n            <p class=\"text-xs text-slate-300 leading-relaxed\">\n              مصطلحات الأشجار، تمثيل العقد في الذاكرة، عمليات المرور الأربعة (Preorder, Inorder, Postorder, Level-order) ومعمل C++ كامل.\n            </p>\n\n            <div class=\"space-y-1.5 pt-2 border-t border-white/10 text-[11px] text-slate-400\">\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-emerald-400\">✓</span>\n                <span>تتبع مرئي لجميع أنواع الـ Tree Traversals</span>\n              </div>\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-emerald-400\">✓</span>\n                <span>كود برمجي كامل مع تنظيف الذاكرة deleteTree</span>\n              </div>\n              <div class=\"flex items-center gap-1.5\">\n                <span class=\"text-emerald-400\">✓</span>\n                <span>كويز فوري بـ 16 سؤالاً تفاعلياً</span>\n              </div>\n            </div>\n          </div>\n\n          <a href=\"lecture-7.html\" class=\"btn-gradient w-full py-3 px-4 rounded-2xl text-white font-black text-xs text-center flex items-center justify-center gap-2 shadow-lg\">\n            <span>فتح الشرح التفاعلي (L7)</span>\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M10 19l-7-7m0 0l7-7m-7 7h18\"/></svg>\n          </a>\n        </article>\n\n"
